    w = [max(len(x) for x in col) for col in zip(headers, *rows)]
    rule = lambda l, m, r: l + m.join(h * (n + 2) for n in w) + r
    line = lambda r: v + v.join(" %-*s " % (n, c) for n, c in zip(w, r)) + v
    print(rule(tl, tm, tr))
    print(line(headers))
    print(rule(ml, mm, mr))
    for r in rows:
