#!/usr/bin/env bash
# dcw — worktree + port + Django server + Celery lifecycle
# Local port of the DevSpace /opt/dev-tools/dev-captain + dcw helpers.
# Self-contained: no /opt/dev-tools, fuser, ss, or flock dependencies.
#
# Commands:
#   dcw start <branch>   create worktree, clone DB, copy private files, point the
#                        worktree .env at its own DB + Redis namespace, then start
#                        the server and a per-branch Celery worker.
#                        if <branch> == base branch, runs in $REPO on $PORT_BASE
#                        (no worktree — the base branch IS $REPO)
#                        base branch = origin/HEAD, else the branch checked out in
#                        $REPO, else main; override with DEV_CAPTAIN_BASE
#                        a NEW branch starts from origin/<base> after a fetch, so
#                        it begins at the latest remote commit, not at the (often
#                        stale) local <base> ref; --no-track keeps it off origin/<base>
#   dcw stop <branch>    stop server + worker; leaves worktree/branch alone
#                        with no <branch>, pick from a numbered menu of captains
#   dcw status           list all captains (port, pid, alive, celery) + URLs
#   dcw list             show all git worktrees (branch, port, dir)
#   dcw path <branch>    print the worktree dir for a branch (base branch -> $REPO)
#                        used by the shell wrapper to cd after `dcw start`
#   dcw abort <branch>   destroy worktree + server + worker + worktree DB (no merge)
#                        with no <branch>, pick from a numbered menu of dcw worktrees
#   dcw logs <branch> [celery]
#                        tail the server log, or the branch's worker log
#   dcw celery start|restart|stop|status [branch]
#                        manage a branch's worker (default: base branch)
#
# Isolation: each worktree gets HMX_INSTANCE_NAMESPACE=<base ns>-<db name>, and HMX
# derives every Redis key from it (hmx:<sha256(ns)>:{celery,celery-result,cache,
# celery-healthcheck}). Branches therefore share Redis DB indexes but never see each
# other's queues, results, cache or realtime events. Beat is deliberately NOT started
# per branch — multiple beats would double-fire schedules against the same DB.
set -euo pipefail

# Optional user config (written by install.sh): ~/.config/dcw/config
# Precedence: environment variables > config file > built-in defaults
DCW_CONFIG="${DCW_CONFIG:-$HOME/.config/dcw/config}"
# shellcheck disable=SC1091
[ -f "$DCW_CONFIG" ] && source "$DCW_CONFIG"

# ── Project config (override via env) ─────────────────────────────
REPO="${DEV_CAPTAIN_REPO:-$HOME/dev/hmx-002}"
VENV="${DEV_CAPTAIN_VENV:-$HOME/dev/.venv}"
PORT_BASE="${PORT_BASE:-5200}"
PORT_MAX="${PORT_MAX:-5220}"

# ── Preview URL domain (DevSpace wildcard nginx, like dev-captain) ─
#   <user>.devx.hashmicro.co        -> 127.0.0.1:$PORT_BASE   (base branch)
#   <user>-<port>.devx.hashmicro.co -> 127.0.0.1:<port>       (worktree)
# Auto-detected so a box without that reverse proxy keeps plain 127.0.0.1 URLs.
# Set DCW_DOMAIN to override; set it EMPTY (DCW_DOMAIN=) to force localhost URLs.
if [ -z "${DCW_DOMAIN+set}" ]; then
  DCW_DOMAIN="${DEVSPACE_DOMAIN:-}"
  if [ -z "$DCW_DOMAIN" ] && [ -r /etc/devspace-nginx-routes.env ]; then
    DCW_DOMAIN=$(awk -F= '$1 == "DEVSPACE_DOMAIN" { print $2; exit }' \
      /etc/devspace-nginx-routes.env 2>/dev/null || true)
  fi
fi
DCW_USER="${DCW_USER:-${USER:-$(id -un)}}"

# ── Per-branch Celery (opt out with DCW_CELERY=0) ─────────────────
# One worker per branch, isolated from every other branch by the branch's
# HMX_INSTANCE_NAMESPACE (see _set_worktree_env_namespace). Queues default to
# every queue the app routes to, so a branch's dev stack consumes its own tasks
# instead of leaving them queued forever.
CELERY_ENABLED="${DCW_CELERY:-1}"
CELERY_QUEUES="${DCW_CELERY_QUEUES:-interactive,import,export,scheduled,notifications,csv,data_import,demo_pool,celery}"
CELERY_CONCURRENCY="${DCW_CELERY_CONCURRENCY:-2}"
CELERY_LOGLEVEL="${DCW_CELERY_LOGLEVEL:-INFO}"

# ── State (in home dir, outside any project) ──────────────────────
WT_DIR="$REPO/.worktrees"
STATE="$HOME/.dev-captain"
LOGDIR="$STATE/logs"
REG="$STATE/ports.json"
LOCK="$STATE/.lock"
CELERY_STATE="$STATE/celery"
mkdir -p "$LOGDIR" "$CELERY_STATE"

# Base branch detection — from origin/HEAD (the branch the repo declares as its
# default), like DevSpace dev-captain. Fallback: the branch currently checked out
# in $REPO, then main. Override with DEV_CAPTAIN_BASE.
BASE="${DEV_CAPTAIN_BASE:-}"
if [ -z "$BASE" ] && [ -d "$REPO/.git" ]; then
  BASE=$(git -C "$REPO" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
  if [ -z "$BASE" ]; then
    BASE=$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [ "$BASE" = "HEAD" ]; then BASE=""; fi
  fi
fi
BASE="${BASE:-main}"

# ── Helpers ───────────────────────────────────────────────────────
_locked() { # simple mutex via mkdir (no flock on macOS)
  for _ in 1 2 3 4 5; do
    mkdir "$LOCK" 2>/dev/null && return 0
    sleep 0.2
  done
  echo "warning: could not acquire lock, proceeding without" >&2
  return 0
}
_unlocked() { rmdir "$LOCK" 2>/dev/null || true; }

_port_of() { # look up port for a branch (empty if none)
  local branch="$1"
  [ -f "$REG" ] || return 0
  python3 -c "
import json
d = json.load(open('$REG'))
for port, info in d.items():
    b = info['branch'] if isinstance(info, dict) else info
    if b == '$branch':
        print(port); break
"
}

_url_of() { # port [branch] -> URL to open (wildcard host when a domain is known)
  local port="$1" branch="${2:-}"
  if [ -z "$DCW_DOMAIN" ]; then
    printf 'http://127.0.0.1:%s\n' "$port"
  elif [ "$branch" = "$BASE" ]; then
    printf 'https://%s.%s\n' "$DCW_USER" "$DCW_DOMAIN"
  else
    printf 'https://%s-%s.%s\n' "$DCW_USER" "$port" "$DCW_DOMAIN"
  fi
}

_record_pid() { # update pid for an existing port entry
  local port="$1" pid="$2"
  python3 -c "
import json, os
d = json.load(open('$REG')) if os.path.exists('$REG') else {}
if '$port' in d:
    info = d['$port']
    if isinstance(info, dict):
        info['pid'] = $pid
    else:
        d['$port'] = {'branch': info, 'pid': $pid}
else:
    d['$port'] = {'branch': '$BASE', 'pid': $pid, 'started_at': __import__('time').time()}
json.dump(d, open('$REG', 'w'), indent=2)
"
}

_find_django_root() { # locate manage.py in a tree
  local tree="$1"
  for candidate in "." "hmx" "src" "backend" "app"; do
    if [ -f "$tree/$candidate/manage.py" ]; then
      echo "$tree/$candidate"
      return 0
    fi
  done
  return 1
}

_port_bound() { # macOS: is a TCP port bound by any process?
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

# ── Per-worktree database (port of DevSpace ~/repo/scripts/dcw) ───
_db_name_for_branch() { # branch -> postgres db name (lowercase, safe chars)
  printf '%s\n' "$1" | tr '/[:upper:].-' '_[:lower:]__' | tr -cd '[:alnum:]_' | cut -c1-63
}

_env_value() { # read KEY= from a .env file (empty if the file is unreadable)
  python3 - "$1" "$2" <<'PY'
import sys
path, key = sys.argv[1:3]
try:
    fh = open(path)
except OSError:
    sys.exit(0)          # no .env -> no value; callers apply their own default
with fh:
    for line in fh:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        if name.strip() == key:
            print(value.strip())
            break
PY
}

_db_conn_vars() { # set db_user/db_password/db_host/db_port from main repo .env
  db_user=$(_env_value "$REPO/hmx/.env" DATABASE_USER)
  db_password=$(_env_value "$REPO/hmx/.env" DATABASE_PASSWORD)
  db_host=$(_env_value "$REPO/hmx/.env" DATABASE_HOST); db_host=${db_host:-127.0.0.1}
  db_port=$(_env_value "$REPO/hmx/.env" DATABASE_PORT); db_port=${db_port:-5432}
}

_db_default_name() { # default.NAME from main repo db.json
  python3 -c "
import json
d = json.load(open('$REPO/hmx/hmx/db.json'))
print(d['default']['NAME'])
" 2>/dev/null || _env_value "$REPO/hmx/.env" DATABASE_NAME
}

_db_clone() { # clone base DB -> worktree DB (template clone, dump/restore fallback)
  local branch="$1"
  command -v psql >/dev/null 2>&1 || { echo "  db:      psql not found; DB clone skipped" >&2; return 0; }
  local src_db dst_db
  src_db=$(_db_default_name)
  dst_db=$(_db_name_for_branch "$branch")
  _db_conn_vars
  if PGPASSWORD="$db_password" psql -w -h "$db_host" -p "$db_port" -U "$db_user" -d postgres -Atqc \
      "SELECT 1 FROM pg_database WHERE datname = '$dst_db'" 2>/dev/null | grep -qx 1; then
    echo "  db:      $dst_db already exists"
    return 0
  fi
  echo "  db:      cloning $src_db -> $dst_db"
  if PGPASSWORD="$db_password" createdb -w -h "$db_host" -p "$db_port" -U "$db_user" -T "$src_db" "$dst_db" 2>/dev/null; then
    return 0
  fi
  echo "  db:      template clone failed (source DB in use?); retrying with dump/restore"
  PGPASSWORD="$db_password" createdb -w -h "$db_host" -p "$db_port" -U "$db_user" "$dst_db" || return 1
  PGPASSWORD="$db_password" pg_dump -w -h "$db_host" -p "$db_port" -U "$db_user" --no-owner --no-privileges "$src_db" \
    | PGPASSWORD="$db_password" psql -w -h "$db_host" -p "$db_port" -U "$db_user" -d "$dst_db" -q
}

_db_drop() { # drop the worktree DB
  local branch="$1"
  command -v dropdb >/dev/null 2>&1 || { echo "  db:      dropdb not found; DB drop skipped" >&2; return 0; }
  local dst_db
  dst_db=$(_db_name_for_branch "$branch")
  _db_conn_vars
  if ! PGPASSWORD="$db_password" psql -w -h "$db_host" -p "$db_port" -U "$db_user" -d postgres -Atqc \
      "SELECT 1 FROM pg_database WHERE datname = '$dst_db'" 2>/dev/null | grep -qx 1; then
    echo "  db:      $dst_db does not exist"
    return 0
  fi
  echo "  db:      dropping $dst_db"
  PGPASSWORD="$db_password" dropdb -w -h "$db_host" -p "$db_port" -U "$db_user" --if-exists "$dst_db" \
    || { echo "  db:      warning: dropdb failed for $dst_db (left in place)" >&2; return 1; }
}

_set_worktree_db_json() { # point worktree db.json default.NAME at its own DB
  local branch="$1"
  local wt="$WT_DIR/$branch" db_json="$WT_DIR/$branch/hmx/hmx/db.json"
  local dst_db; dst_db=$(_db_name_for_branch "$branch")
  [ -f "$db_json" ] || { echo "  db.json: $db_json not found; skipped" >&2; return 0; }
  python3 - "$db_json" "$dst_db" <<'PY'
import json, sys
path, name = sys.argv[1:3]
with open(path) as fh:
    data = json.load(fh)
data["default"]["NAME"] = name
with open(path, "w") as fh:
    json.dump(data, fh, indent=4)
    fh.write("\n")
PY
  echo "  db.json: default.NAME = $dst_db"
}

_set_worktree_env_db() { # point worktree .env DATABASE_NAME at its own DB
  local branch="$1"
  local env_file="$WT_DIR/$branch/hmx/.env"
  local dst_db; dst_db=$(_db_name_for_branch "$branch")
  [ -f "$env_file" ] || { echo "  .env:    $env_file not found; skipped" >&2; return 0; }
  python3 - "$env_file" "$dst_db" <<'PY'
import sys
path, name = sys.argv[1:3]
with open(path) as fh:
    lines = fh.read().splitlines()
out, seen = [], False
for line in lines:
    if line.startswith("DATABASE_NAME="):
        out.append(f"DATABASE_NAME={name}")
        seen = True
    else:
        out.append(line)
if not seen:
    out.append(f"DATABASE_NAME={name}")
with open(path, "w") as fh:
    fh.write("\n".join(out) + "\n")
PY
  echo "  .env:    DATABASE_NAME = $dst_db"
}

_set_worktree_env_namespace() { # give this worktree its own Redis key scope
  # HMX derives EVERY Redis key from HMX_INSTANCE_NAMESPACE (sha256 -> scope):
  #   hmx:<scope>:celery:        broker queues + results
  #   hmx:<scope>:cache          django cache
  #   hmx:<scope>:celery-healthcheck
  # So a distinct namespace per branch isolates Celery and the cache without
  # touching the shared Redis DB indexes. Web and worker MUST agree, which is
  # why this is written to the worktree .env rather than exported per process.
  local branch="$1"
  local env_file="$WT_DIR/$branch/hmx/.env"
  [ -f "$env_file" ] || { echo "  .env:    $env_file not found; namespace skipped" >&2; return 0; }
  local base_ns ns
  base_ns=$(_env_value "$REPO/hmx/.env" HMX_INSTANCE_NAMESPACE)
  ns=$(_db_name_for_branch "$branch")
  [ -n "$base_ns" ] && ns="$base_ns-$ns"
  python3 - "$env_file" "$ns" <<'PY'
import sys
path, name = sys.argv[1:3]
with open(path) as fh:
    lines = fh.read().splitlines()
out, seen = [], False
for line in lines:
    if line.startswith("HMX_INSTANCE_NAMESPACE="):
        out.append(f"HMX_INSTANCE_NAMESPACE={name}")
        seen = True
    else:
        out.append(line)
if not seen:
    out.append(f"HMX_INSTANCE_NAMESPACE={name}")
with open(path, "w") as fh:
    fh.write("\n".join(out) + "\n")
PY
  echo "  .env:    HMX_INSTANCE_NAMESPACE = $ns"
}

# ── Per-branch Celery worker ──────────────────────────────────────
_slug() { printf '%s' "$1" | tr '/' '_'; }

_branch_root() { # django root for a branch (base lives in $REPO itself)
  local branch="$1" tree
  if [ "$branch" = "$BASE" ]; then tree="$REPO"; else tree="$WT_DIR/$branch"; fi
  [ -d "$tree" ] || return 1
  _find_django_root "$tree"
}

_celery_pidfile() { printf '%s/%s.pid' "$CELERY_STATE" "$(_slug "$1")"; }
_celery_logfile() { printf '%s/%s-celery.log' "$LOGDIR" "$(_slug "$1")"; }

_celery_pid() { # live worker pid for a branch; empty if none/dead/zombie
  # ALWAYS returns 0. Callers do `pid=$(_celery_pid ...)` under `set -e`, where a
  # non-zero status from the substitution aborts the whole script.
  local pf pid state
  pf=$(_celery_pidfile "$1")
  [ -s "$pf" ] || return 0
  pid=$(head -1 "$pf" 2>/dev/null || true)
  [ -n "$pid" ] || return 0
  # kill -0 also succeeds for a ZOMBIE, which is how a worker that died during
  # startup got reported as "up". Check the real process state too.
  kill -0 "$pid" 2>/dev/null || return 0
  state=$(sed 's/^.*) //' "/proc/$pid/stat" 2>/dev/null | cut -d' ' -f1)
  [ "$state" = "Z" ] && return 0
  printf '%s' "$pid"
  return 0
}

_celery_namespace() { # namespace a branch's .env resolves to (empty if unknown)
  local branch="$1" env_file
  if [ "$branch" = "$BASE" ]; then env_file="$REPO/hmx/.env"; else env_file="$WT_DIR/$branch/hmx/.env"; fi
  [ -f "$env_file" ] && _env_value "$env_file" HMX_INSTANCE_NAMESPACE
}

_celery_ready() { # has the worker announced readiness in its log?
  # Celery prints "<hostname> ready." once the app is fully loaded. Process
  # liveness alone is NOT readiness: an HMX worker spends ~15-30s importing
  # modules, and a worker started with bad args stays alive for seconds before
  # its CLI validation kills it — liveness alone reported those as "up".
  local log
  log=$(_celery_logfile "$1")
  [ -f "$log" ] && grep -q ' ready\.' "$log"
}

_celery_start() { # start the branch's worker (idempotent)
  # $2 = 1 to block until the worker is ready (the explicit `dcw celery start`),
  # 0/unset to only confirm it survived startup (the `dcw start` path, which must
  # stay fast — the worker keeps loading in the background).
  # Returns non-zero only when a worker was requested and did not come up, so the
  # explicit command can fail loudly. Callers on the `dcw start` path append
  # `|| true`: the server is the primary artifact and a worker problem must not
  # make `dcw start` exit non-zero.
  local branch="$1" wait="${2:-0}"
  local pf log root existing celery_bin pid n budget
  if [ "$CELERY_ENABLED" != 1 ]; then
    echo "  celery:  skipped (DCW_CELERY=$CELERY_ENABLED)"
    return 0
  fi
  pf=$(_celery_pidfile "$branch"); log=$(_celery_logfile "$branch")
  existing=$(_celery_pid "$branch")
  if [ -n "$existing" ]; then
    echo "  celery:  already running (pid $existing)"
    return 0
  fi
  root=$(_branch_root "$branch") || { echo "  celery:  django root not found; worker NOT started" >&2; return 1; }
  celery_bin="$VENV/bin/celery"
  if [ ! -x "$celery_bin" ]; then celery_bin=$(command -v celery 2>/dev/null || true); fi
  [ -n "$celery_bin" ] || { echo "  celery:  celery binary not found; worker NOT started" >&2; return 1; }
  (
    cd "$root" || exit 1
    # shellcheck disable=SC1091
    [ -f "$VENV/bin/activate" ] && source "$VENV/bin/activate"
    nohup "$celery_bin" -A hmx worker \
      --loglevel="$CELERY_LOGLEVEL" \
      --concurrency="$CELERY_CONCURRENCY" \
      --hostname="dcw-$(_slug "$branch")@%h" \
      -Q "$CELERY_QUEUES" > "$log" 2>&1 &
    # pid + branch, so `celery status` can name the branch behind a slugged file
    printf '%s\n%s\n' "$!" "$branch" > "$pf"
  )
  n=0
  while [ "$n" -lt 20 ]; do          # up to 10s for the process to appear
    pid=$(_celery_pid "$branch")
    [ -n "$pid" ] && break
    sleep 0.5; n=$((n+1))
  done
  if [ -z "$pid" ]; then
    echo "  celery:  worker did NOT start (server is unaffected); last log lines:" >&2
    tail -15 "$log" >&2 2>/dev/null || true
    rm -f "$pf"
    return 1
  fi
  budget=4                            # ~2s: catch a process that dies right away
  [ "$wait" = 1 ] && budget=120       # ~60s: HMX module load takes 15-30s
  n=0
  while [ "$n" -lt "$budget" ]; do
    pid=$(_celery_pid "$branch")
    [ -z "$pid" ] && break            # died -> fail below
    _celery_ready "$branch" && break
    sleep 0.5; n=$((n+1))
  done
  pid=$(_celery_pid "$branch")
  if [ -z "$pid" ]; then
    echo "  celery:  worker did NOT start (server is unaffected); last log lines:" >&2
    tail -15 "$log" >&2 2>/dev/null || true
    rm -f "$pf"
    return 1
  fi
  if _celery_ready "$branch"; then
    echo "  celery:  worker up (pid $pid, ns $(_celery_namespace "$branch"))"
    return 0
  fi
  if [ "$wait" = 1 ]; then
    echo "  celery:  worker alive but never became ready (~60s); see $log" >&2
    return 1
  fi
  echo "  celery:  worker starting (pid $pid, ns $(_celery_namespace "$branch"))"
  echo "           HMX module load takes ~15-30s; watch: dcw logs $branch celery"
  return 0
}

_celery_stop() { # stop the branch's worker (keeps the branch/worktree)
  local branch="$1" pid n
  pid=$(_celery_pid "$branch")
  if [ -z "$pid" ]; then
    rm -f "$(_celery_pidfile "$branch")"
    echo "  celery:  not running"
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null || true
  n=0
  while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 30 ]; do sleep 0.5; n=$((n+1)); done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$(_celery_pidfile "$branch")"
  echo "  celery:  stopped (pid $pid)"
}

_copy_private_paths() { # copy agent/config files repo -> worktree (once), git-exclude them
  local branch="$1"
  local wt="$WT_DIR/$branch"
  local name src dst exclude
  for name in ".agents" ".claude" ".vscode" "AGENTS.md" "CLAUDE.md" "hmx/hmx/db.json"; do
    src="$REPO/$name"
    dst="$wt/$name"
    [ -e "$src" ] || continue            # source missing (e.g. CLAUDE.md) — fine
    [ -e "$dst" ] || {                   # copy only if not already there
      mkdir -p "$(dirname "$dst")"
      cp -a "$src" "$dst"
      echo "  copy:    $dst <- $src"
    }
    # add to worktree-local git exclude so it never gets committed
    exclude=$(git -C "$wt" rev-parse --git-path info/exclude 2>/dev/null || true)
    case "$exclude" in /*) ;; *) exclude="$wt/$exclude" ;; esac
    if [ -n "$exclude" ] && [ -f "$exclude" ]; then
      grep -Fxq "/$name" "$exclude" || printf '/%s\n' "$name" >> "$exclude"
    fi
  done
}

_start_server() { # start runserver in dir on port, track pid
  local tree="$1" port="$2" log="$3"
  local django_root
  django_root=$(_find_django_root "$tree") || {
    echo "⚠  manage.py not found in $tree (or common subdirs) — server NOT started" >&2
    return 1
  }
  cd "$django_root"
  # shellcheck disable=SC1091
  [ -f "$VENV/bin/activate" ] && source "$VENV/bin/activate"
  if [ -x "$VENV/bin/hmx" ]; then          # DevSpace-style: hmx CLI from hmx_license
    nohup "$VENV/bin/hmx" runserver "127.0.0.1:$port" > "$log" 2>&1 &
  elif command -v hmx >/dev/null 2>&1; then
    nohup hmx runserver "127.0.0.1:$port" > "$log" 2>&1 &
  else                                     # local fallback: plain manage.py
    nohup python3 manage.py runserver "127.0.0.1:$port" --noreload > "$log" 2>&1 &
  fi
  local pid=$!
  disown
  _record_pid "$port" "$pid"
  echo "$pid"
}

_pid_for_port() { # live pid recorded for a port
  local port="$1"
  [ -f "$REG" ] || return 0
  python3 -c "
import json, os
d = json.load(open('$REG'))
info = d.get('$port')
if isinstance(info, dict):
    pid = info.get('pid', 0)
    if pid:
        try: os.kill(int(pid), 0); print(pid)
        except: pass
" 2>/dev/null
}

_kill_port() { # SIGTERM grace + SIGKILL (macOS: lsof, no fuser)
  local port="$1"
  # Kill recorded parent pid first (reloader parent may respawn a killed child)
  local rec_pid
  rec_pid=$(python3 -c "
import json
try:
    d = json.load(open('$REG'))
    info = d.get('$port')
    if isinstance(info, dict) and info.get('pid'):
        print(info['pid'])
except Exception: pass
" 2>/dev/null || true)
  [ -n "$rec_pid" ] && kill -TERM "$rec_pid" 2>/dev/null || true
  local pids
  pids=$(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)
  [ -n "$pids" ] && echo "$pids" | xargs kill -TERM 2>/dev/null || true
  sleep 1
  [ -n "$rec_pid" ] && kill -KILL "$rec_pid" 2>/dev/null || true
  pids=$(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)
  [ -n "$pids" ] && echo "$pids" | xargs kill -KILL 2>/dev/null || true
  # Clear pid from registry (keep the port entry if it's the base branch)
  python3 -c "
import json, os
d = json.load(open('$REG')) if os.path.exists('$REG') else {}
info = d.get('$port')
if isinstance(info, dict) and info.get('branch') == '$BASE':
    info['pid'] = 0
    d['$port'] = info
elif '$port' in d:
    del d['$port']
json.dump(d, open('$REG', 'w'), indent=2)
" || true
}

_port_alloc() { # allocate first free port in [PORT_BASE+1, PORT_MAX-1]
  local branch="$1" p
  _locked
  [ -f "$REG" ] || echo '{}' > "$REG"
  local existing
  existing=$(_port_of "$branch")
  if [ -n "$existing" ]; then _unlocked; echo "$existing"; return 0; fi
  for p in $(seq $((PORT_BASE+1)) $((PORT_MAX-1))); do
    if python3 -c "import json,sys; d=json.load(open('$REG')); sys.exit(0 if '$p' in d else 1)" 2>/dev/null; then
      continue
    fi
    if _port_bound "$p"; then continue; fi
    python3 - "$REG" "$p" "$branch" <<'PYCLAIM'
import json, sys
reg, port, branch = sys.argv[1], sys.argv[2], sys.argv[3]
d = json.load(open(reg))
d[port] = {"branch": branch, "pid": 0, "started_at": __import__("time").time()}
json.dump(d, open(reg, "w"), indent=2)
PYCLAIM
    _unlocked
    echo "$p"
    return 0
  done
  _unlocked
  echo "error: no free port in $((PORT_BASE+1))-$((PORT_MAX-1))" >&2
  return 1
}

_port_free() { # release a port registration (by port or branch)
  local key="${1:?}"
  _locked
  [ -f "$REG" ] && python3 - "$REG" "$key" <<'PYFREE'
import json, sys
reg, key = sys.argv[1], sys.argv[2]
d = json.load(open(reg))
out = {}
for port, info in d.items():
    b = info['branch'] if isinstance(info, dict) else info
    if port == key or b == key:
        continue
    out[port] = info
json.dump(out, open(reg, "w"), indent=2)
PYFREE
  _unlocked
}

# ── Interactive target picker (dcw stop / dcw abort without a branch) ─────
# With no branch argument both commands print a numbered menu and read a
# selection, so the branch name does not have to be remembered. The candidate
# set differs per command: stop lists captains from the port registry, abort
# lists the worktrees dcw actually manages ($WT_DIR children only — abort never
# touches any other path). Selection accepts a number, several numbers (space or
# comma separated), or a branch name; Enter alone picks the single candidate when
# there is exactly one, and q cancels.
_abort_one() { # destroy worktree + port + worker + DB for ONE branch
  # Every step is non-fatal: this runs in a loop for multi-target abort, and one
  # target's failure (unreadable .env, dropdb refused) must not strand the rest.
  local branch="$1" wt port
  wt="$WT_DIR/$branch"
  port=$(_port_of "$branch")
  if [ -n "$port" ]; then
    _kill_port "$port"
    _port_free "$port"
  fi
  _celery_stop "$branch"
  # if-form, not `[ -d ] && git ...`: a failing AND-list would trip errexit
  if [ -d "$wt" ]; then
    git -C "$REPO" worktree remove --force "$wt" \
      || echo "dcw: warning: could not remove worktree $wt" >&2
  fi
  git -C "$REPO" branch -D "$branch" 2>/dev/null || true
  _db_drop "$branch" || true
  echo "✓ aborted $branch"
}

_pick_rows_stop() { # port<TAB>branch<TAB>up|down — live captains first
  [ -f "$REG" ] || return 0
  python3 - "$REG" <<'PYSTOP'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}

def alive(pid):
    # 'Z' counts as dead: os.kill(pid, 0) succeeds for a zombie, so a process
    # that died during startup would otherwise read as running.
    try:
        st = open(f"/proc/{int(pid)}/stat").read().rsplit(") ", 1)[1].split(" ", 1)[0]
    except Exception:
        return False
    return st != "Z"

rows = []
for port, info in d.items():
    b = info.get("branch") if isinstance(info, dict) else info
    if not b:
        continue
    pid = info.get("pid", 0) if isinstance(info, dict) else 0
    up = bool(pid) and alive(pid)
    rows.append((0 if up else 1, int(port), b, "up" if up else "down"))
rows.sort()
for _, port, b, s in rows:
    print(f"{port}\t{b}\t{s}")
PYSTOP
}

_pick_rows_abort() { # port<TAB>branch<TAB>head<TAB>dir — dcw worktrees only
  [ -d "$REPO/.git" ] || return 0
  python3 - "$REPO" "$WT_DIR" "$REG" <<'PYABT'
import json, os, subprocess, sys
repo, wt_dir, reg = sys.argv[1:4]
try:
    d = json.load(open(reg))
except Exception:
    d = {}
bp = {}
for port, info in d.items():
    b = info.get("branch") if isinstance(info, dict) else info
    if b:
        bp[b] = port
out = subprocess.run(["git", "-C", repo, "worktree", "list", "--porcelain"],
                     capture_output=True, text=True).stdout
for block in [b for b in out.strip().split("\n\n") if b.strip()]:
    wt = branch = head = ""
    for line in block.splitlines():
        if line.startswith("worktree "):
            wt = line[len("worktree "):]
        elif line.startswith("branch "):
            branch = line[len("branch "):].replace("refs/heads/", "")
        elif line.startswith("HEAD "):
            head = line[len("HEAD "):][:9]
    if not branch:
        continue                  # detached: agent scratch worktrees, not dcw's
    if os.path.dirname(os.path.abspath(wt)) != os.path.abspath(wt_dir):
        continue                  # outside $WT_DIR: abort would not touch it anyway
    print(f"{bp.get(branch, '-')}\t{branch}\t{head}\t{os.path.relpath(wt, repo)}")
PYABT
}

_pick_targets() { # <stop|abort> -> selected branches on stdout; 1 = cancelled
  local mode="$1" rows n i
  rows=$(mktemp "${TMPDIR:-/tmp}/dcw-pick.XXXXXX")
  if [ "$mode" = stop ]; then
    _pick_rows_stop > "$rows"
  else
    _pick_rows_abort > "$rows"
  fi
  n=$(awk 'NF' "$rows" | wc -l)
  if [ "$n" -eq 0 ]; then
    rm -f "$rows"
    if [ "$mode" = stop ]; then
      echo "no captains in $REG — nothing to stop" >&2
    else
      echo "no dcw worktrees under $WT_DIR — nothing to abort" >&2
    fi
    return 1
  fi

  local -a name=() meta=()
  local f1 f2 f3 f4
  while IFS=$'\t' read -r f1 f2 f3 f4; do
    [ -n "$f2" ] || continue
    name+=("$f2")
    if [ "$mode" = stop ]; then meta+=("$f1|$f3"); else meta+=("$f1|$f3|$f4"); fi
  done < "$rows"
  rm -f "$rows"

  # Menu goes to stderr and only the chosen branches go to stdout: the caller
  # captures stdout (`selected=$(_pick_targets ...)`), so mixing them would
  # capture the menu too.
  if [ "$mode" = stop ]; then
    printf '%-4s %-38s %-7s %s\n' '#' 'BRANCH' 'PORT' 'STATUS' >&2
  else
    printf '%-4s %-38s %-7s %-10s %s\n' '#' 'BRANCH' 'PORT' 'HEAD' 'DIR' >&2
  fi
  local m port st head dir
  for ((i = 0; i < ${#name[@]}; i++)); do
    m="${meta[$i]}"
    if [ "$mode" = stop ]; then
      IFS='|' read -r port st <<<"$m"
      printf '%-4s %-38s %-7s %s\n' "$((i + 1))" "${name[$i]}" "$port" "$st" >&2
    else
      IFS='|' read -r port head dir <<<"$m"
      printf '%-4s %-38s %-7s %-10s %s\n' "$((i + 1))" "${name[$i]}" "$port" "$head" "$dir" >&2
    fi
  done

  local attempt=0 reply tok bad k hit found u
  local -a out=() uniq=()
  while [ "$attempt" -lt 3 ]; do
    attempt=$((attempt + 1))
    if [ "$n" -eq 1 ]; then
      printf 'Select [1] (Enter = 1, q = cancel): ' >&2
    else
      printf 'Select (number(s), branch name, q = cancel): ' >&2
    fi
    IFS= read -r reply || return 1
    reply="${reply//,/ }"
    # shellcheck disable=SC2086
    set -- $reply
    if [ $# -eq 0 ]; then
      if [ "$n" -eq 1 ]; then printf '%s\n' "${name[0]}"; return 0; fi
      echo "nothing selected" >&2
      continue
    fi
    out=(); bad=0
    for tok in "$@"; do
      case "$tok" in
        q|Q|quit|exit) return 1 ;;
      esac
      if [[ "$tok" =~ ^[0-9]+$ ]] && [ "$tok" -ge 1 ] && [ "$tok" -le "$n" ]; then
        out+=("${name[$((tok - 1))]}")
        continue
      fi
      hit=""
      for ((k = 0; k < ${#name[@]}; k++)); do
        if [ "${name[$k]}" = "$tok" ]; then hit="${name[$k]}"; break; fi
      done
      if [ -n "$hit" ]; then out+=("$hit"); else echo "invalid choice: $tok" >&2; bad=1; fi
    done
    [ "$bad" -eq 1 ] && continue
    uniq=()
    for u in ${out[@]+"${out[@]}"}; do      # ${arr[@]+...} keeps set -u happy on bash < 4.4
      found=0
      for tok in ${uniq[@]+"${uniq[@]}"}; do [ "$tok" = "$u" ] && found=1; done
      [ "$found" -eq 0 ] && uniq+=("$u")
    done
    if [ "${#uniq[@]}" -eq 0 ]; then echo "nothing selected" >&2; continue; fi
    printf '%s\n' "${uniq[@]}"
    return 0
  done
  echo "too many invalid attempts — cancelled" >&2
  return 1
}

cmd="${1:-help}"; shift || true

case "$cmd" in
  start)
    branch="${1:?usage: dcw start <branch>}"

    [ -d "$REPO/.git" ] || { echo "error: $REPO is not a git repo — clone first" >&2; exit 2; }

    if [ "$branch" = "$BASE" ]; then
      # ── BASE BRANCH FAST PATH — no worktree, $REPO on $PORT_BASE ──
      port="$PORT_BASE"
      # $REPO serves whatever branch it has checked out. With BASE read from
      # origin/HEAD those can differ, so say so instead of silently labelling the
      # running code as $BASE.
      repo_head=$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
      if [ -n "$repo_head" ] && [ "$repo_head" != "$BASE" ]; then
        echo "warning: $REPO has '$repo_head' checked out, not $BASE — this server runs $repo_head." >&2
        echo "         run 'git -C $REPO switch $BASE' to serve $BASE." >&2
      fi
      existing_pid=$(_pid_for_port "$port")
      if [ -n "$existing_pid" ]; then
        echo "✓ $branch already running (pid $existing_pid) on port $port"
        echo "  preview: $(_url_of "$port" "$branch")"
        _celery_start "$branch" || true
        exit 0
      fi
      log="$LOGDIR/main.log"
      pid=$(_start_server "$REPO" "$port" "$log")
      echo "✓ captain started: $branch (base)"
      echo "  dir:     $REPO"
      echo "  port:    $port  (pid $pid)"
      echo "  preview: $(_url_of "$port" "$branch")"
      echo "  log:     $log"
      _celery_start "$branch" || true
      exit 0
    fi

    # ── WORKTREE PATH ──
    wt="$WT_DIR/$branch"
    # git refuses to add a worktree for a branch that $REPO already has checked
    # out. Reachable now that BASE comes from origin/HEAD: e.g. `dcw start <branch
    # checked out in $REPO>` while origin/HEAD points at a different branch.
    if [ "$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)" = "$branch" ]; then
      echo "error: $branch is checked out in $REPO — git cannot add it as a worktree." >&2
      echo "       switch $REPO to $BASE, or set DEV_CAPTAIN_BASE=$branch if that is your base branch." >&2
      exit 2
    fi
    if [ ! -d "$wt" ]; then
      cd "$REPO"
      # NOTE: `git fetch origin 2>&1 | tail -3` always exits 0 (the pipeline's
      # status is tail's), so the old `if !` never fired. Capture the output
      # instead so a real fetch failure is actually reported.
      fetch_out=$(git fetch origin 2>&1) || {
        echo "dcw: warning: git fetch origin failed; using existing local refs" >&2
      }
      if [ -n "$fetch_out" ]; then
        printf '%s\n' "$fetch_out" | tail -3
      fi
      # Start-point order: an existing local branch wins (that is a branch the
      # user already has), then the REMOTE base, then the local base. The remote
      # base must outrank the local one: `$REPO` has $BASE checked out, so its
      # local ref only moves when someone pulls there — dcw's fetch refreshes
      # refs/remotes/origin/* only. Reading the local ref made new worktrees
      # start from a stale commit (e.g. 6 behind origin/Inventory).
      # --no-track: the new branch is not a copy of $BASE, so it must not push
      # to origin/$BASE by default.
      if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$wt" "$branch"
      elif git show-ref --verify --quiet "refs/remotes/origin/$BASE"; then
        git worktree add -b "$branch" "$wt" --no-track "origin/$BASE"
      elif git show-ref --verify --quiet "refs/heads/$BASE"; then
        git worktree add -b "$branch" "$wt" "$BASE"
      else
        echo "dcw: error: neither origin/$BASE nor local $BASE exists in $REPO." >&2
        echo "       fetch the base branch, or set DEV_CAPTAIN_BASE=<branch>." >&2
        exit 2
      fi
    fi

# Copy .env from main repo into worktree (gitignored, so never travels with git)
    for env_src in "$REPO/hmx/.env" "$REPO/.env"; do
      env_dst="${env_src/#$REPO/$wt}"
      if [ -f "$env_src" ] && [ ! -f "$env_dst" ]; then
        cp "$env_src" "$env_dst"
        echo "  env:     copied $(basename "$(dirname "$env_src")")/.env → worktree"
      fi
    done

    # Per-worktree DB + private files (like DevSpace dcw)
    _copy_private_paths "$branch"
    _db_clone "$branch"
    _set_worktree_db_json "$branch"
    _set_worktree_env_db "$branch"
    _set_worktree_env_namespace "$branch"

    port=$(_port_alloc "$branch")

    existing_pid=$(_pid_for_port "$port")
    if [ -n "$existing_pid" ]; then
      echo "already running (pid $existing_pid)"
      echo "  preview: $(_url_of "$port" "$branch")"
      _celery_start "$branch" || true
      exit 0
    fi

    log="$LOGDIR/$(_slug "$branch").log"
    pid=$(_start_server "$wt" "$port" "$log") || {
      echo "⚠ worktree + port reserved; spawn manually when ready"
      _celery_start "$branch" || true
      exit 0
    }

    echo "✓ captain started: $branch"
    echo "  worktree: $wt"
    echo "  port:     $port  (pid $pid)"
    echo "  preview:  $(_url_of "$port" "$branch")"
    echo "  log:      $log"
    _celery_start "$branch" || true
    ;;

  stop)
    branch="${1:-}"
    if [ -z "$branch" ]; then
      # No branch given: pick from the captains in the registry. Interactive
      # only — a non-TTY (script, cron) would just block on the read.
      if [ ! -t 0 ]; then
        echo "usage: dcw stop <branch>   (run it in a terminal to pick from a list)" >&2
        exit 2
      fi
      selected=$(_pick_targets stop) || exit 0   # cancelled / nothing running
      while IFS= read -r branch; do
        [ -n "$branch" ] || continue
        port=$(_port_of "$branch")
        if [ -z "$port" ]; then
          if [ "$branch" = "$BASE" ]; then
            port="$PORT_BASE"
          else
            echo "no captain running for $branch"
            _celery_stop "$branch"
            continue
          fi
        fi
        _kill_port "$port"
        _celery_stop "$branch"
        echo "✓ stopped $branch (port $port) — worktree/branch left intact"
      done <<< "$selected"
      exit 0
    fi
    port=$(_port_of "$branch")
    if [ -z "$port" ]; then
      if [ "$branch" = "$BASE" ]; then
        port="$PORT_BASE"
      else
        echo "no captain running for $branch"
        _celery_stop "$branch"
        exit 0
      fi
    fi
    _kill_port "$port"
    _celery_stop "$branch"
    echo "✓ stopped $branch (port $port) — worktree/branch left intact"
    ;;

  status|ps)
    python3 <<PYSTAT
import json, os, subprocess
try:
    d = json.load(open("$REG"))
except Exception:
    d = {}
cel_dir = "$CELERY_STATE"
cel_log = "$LOGDIR"

# Preview URL — mirrors _url_of() in the shell half of this script.
domain = "$DCW_DOMAIN"
me = "$DCW_USER"
base = "$BASE"

def url_for(port, branch):
    if not domain:
        return f"http://127.0.0.1:{port}"
    if branch == base:
        return f"https://{me}.{domain}"
    return f"https://{me}-{port}.{domain}"

def proc_state(pid):
    # 'Z' matters: kill -0 (and os.kill(pid, 0)) succeeds for a zombie, so a
    # process that died during startup would otherwise read as alive.
    try:
        return open(f"/proc/{pid}/stat").read().rsplit(") ", 1)[1].split(" ", 1)[0]
    except Exception:
        return None

def listener(port):
    try:
        r = subprocess.run(["lsof", "-tiTCP:%s" % port, "-sTCP:LISTEN"],
                           capture_output=True, text=True, timeout=5)
        return bool(r.stdout.strip())
    except Exception:
        return False

def celery_state(branch):
    pf = os.path.join(cel_dir, branch.replace("/", "_") + ".pid")
    try:
        pid = int(open(pf).read().split()[0])
    except Exception:
        return "-"
    state = proc_state(pid)
    if state is None or state == "Z":
        return "dead"
    log = os.path.join(cel_log, branch.replace("/", "_") + "-celery.log")
    try:
        with open(log, "rb") as fh:
            return "ready" if b" ready." in fh.read(4_000_000) else "starting"
    except Exception:
        return "starting"

rows = []
for port, info in sorted(d.items(), key=lambda x: int(x[0])):
    if isinstance(info, dict):
        branch = info.get("branch", "?")
        pid = info.get("pid", 0) or 0
    else:
        branch, pid = info, 0
    state = proc_state(pid) if pid else None
    if state is not None and state != "Z":
        status = "up"
    elif listener(port):
        status = "up"            # something serves the port even if no pid is recorded
    elif pid == 0:
        # dcw stop leaves a pid=0 tombstone for the base branch so its port stays
        # reserved. Nothing is listening, so it is NOT an active captain — and it
        # is permanent after the first base start, so it must not be noise.
        status = "reserved"
    else:
        status = "dead"
    rows.append((port, branch, pid, status))

workers = []
if os.path.isdir(cel_dir):
    for name in sorted(os.listdir(cel_dir)):
        if not name.endswith(".pid"):
            continue
        try:
            parts = open(os.path.join(cel_dir, name)).read().split()
            b = parts[1] if len(parts) > 1 else name[:-4]
        except Exception:
            continue
        st = celery_state(b)
        if st in ("ready", "starting"):
            workers.append((b, st))

shown = [r for r in rows if r[3] in ("up", "dead")]
if not shown and not workers:
    print("(no active captains)")
else:
    print(f"{'PORT':<7}{'BRANCH':<40}{'PID':<10}{'STATUS':<10}{'CELERY':<10}URL")
    for port, branch, pid, status in shown:
        url = url_for(port, branch)
        print(f"{port:<7}{branch:<40}{str(pid):<10}{status:<10}{celery_state(branch):<10}{url}")
    for b, st in workers:
        if not any(r[1] == b for r in shown):
            print(f"{'-':<7}{b:<40}{'-':<10}{'worker only':<12}{st:<10}(no server)")
PYSTAT
    ;;

  list|worktrees|wt)
    [ -d "$REPO/.git" ] || { echo "error: $REPO is not a git repo" >&2; exit 2; }
    python3 - "$REPO" "$REG" <<'PYLIST'
import json, os, subprocess, sys
repo, reg = sys.argv[1], sys.argv[2]
try:
    entries = json.load(open(reg))
except Exception:
    entries = {}
branch_port = {}
for port, info in entries.items():
    b = info.get("branch") if isinstance(info, dict) else info
    if b:
        branch_port[b] = port
out = subprocess.run(
    ["git", "-C", repo, "worktree", "list", "--porcelain"],
    capture_output=True, text=True,
).stdout
blocks = [b for b in out.strip().split("\n\n") if b.strip()]
print(f"{'BRANCH':<32}{'PORT':<7}{'HEAD':<10}DIR")
for block in blocks:
    wt = branch = head = ""
    for line in block.splitlines():
        if line.startswith("worktree "):
            wt = line[len("worktree "):]
        elif line.startswith("branch "):
            branch = line[len("branch "):].replace("refs/heads/", "")
        elif line.startswith("HEAD "):
            head = line[len("HEAD "):][:9]
    rel = os.path.relpath(wt, repo)
    display = "(repo)" if rel == "." else rel
    if not branch:
        branch = "(detached)"
    port = str(branch_port.get(branch, "-")) if branch != "(detached)" else "-"
    print(f"{branch:<32}{port:<7}{head:<10}{display}")
PYLIST
    ;;

  path|dir)
    # Print the directory a branch lives in. Existence is NOT checked: the shell
    # wrapper asks for this before `dcw start` creates the worktree.
    branch="${1:?usage: dcw path <branch>}"
    if [ "$branch" = "$BASE" ]; then
      printf '%s\n' "$REPO"
    else
      printf '%s\n' "$WT_DIR/$branch"
    fi
    ;;

  abort)
    branch="${1:-}"
    if [ -z "$branch" ]; then
      # No branch given: pick from the dcw-managed worktrees. Interactive only —
      # a non-TTY (script, cron) would just block on the read.
      if [ ! -t 0 ]; then
        echo "usage: dcw abort <branch>   (run it in a terminal to pick from a list)" >&2
        exit 2
      fi
      selected=$(_pick_targets abort) || exit 1   # cancelled / nothing to abort
      targets=()
      while IFS= read -r b; do
        [ -n "$b" ] && targets+=("$b")
      done <<< "$selected"
      # Belt and braces: the picker only offers $WT_DIR children, so $BASE
      # cannot appear — but destroying $REPO is unrecoverable, so re-check.
      # ${arr[@]+...} guards keep `set -u` happy if the array were ever empty.
      for b in ${targets[@]+"${targets[@]}"}; do
        if [ "$b" = "$BASE" ]; then
          echo "error: cannot abort '$BASE' — that would destroy $REPO. Use 'dcw stop $BASE' to just stop the server." >&2
          exit 2
        fi
      done
      echo "Will destroy:"
      for b in ${targets[@]+"${targets[@]}"}; do
        p=$(_port_of "$b")
        echo "  $b  →  $WT_DIR/$b  (port ${p:--})"
      done
      echo "NO merge."
      read -r -p "Proceed? [y/N] " yn
      [[ "$yn" =~ ^[Yy]$ ]] || { echo "aborted"; exit 1; }
      for b in ${targets[@]+"${targets[@]}"}; do
        _abort_one "$b"
      done
      exit 0
    fi
    if [ "$branch" = "$BASE" ]; then
      echo "error: cannot abort '$BASE' — that would destroy $REPO. Use 'dcw stop $BASE' to just stop the server." >&2
      exit 2
    fi
    wt="$WT_DIR/$branch"
    port=$(_port_of "$branch")

    echo "Will: destroy worktree $wt and free port $port. NO merge."
    read -r -p "Proceed? [y/N] " yn
    [[ "$yn" =~ ^[Yy]$ ]] || { echo "aborted"; exit 1; }

    _abort_one "$branch"
    ;;

  celery)
    sub="${1:-status}"; shift || true
    case "$sub" in
      start|restart)
        branch="${1:-$BASE}"
        [ "$sub" = restart ] && _celery_stop "$branch"
        # explicit request -> block until the worker is ready (or fail loudly)
        _celery_start "$branch" 1 || exit 1
        ;;
      stop)
        branch="${1:-$BASE}"
        _celery_stop "$branch"
        ;;
      status)
        python3 - "$CELERY_STATE" "$LOGDIR" "$REPO" "$WT_DIR" "$BASE" <<'PYCEL'
import os, sys
cel_dir, log_dir, repo, wt_dir, base = sys.argv[1:6]

def namespace_of(branch):
    env_file = (os.path.join(repo, "hmx", ".env") if branch == base
                else os.path.join(wt_dir, branch, "hmx", ".env"))
    try:
        for line in open(env_file):
            if line.startswith("HMX_INSTANCE_NAMESPACE="):
                return line.split("=", 1)[1].strip()
    except Exception:
        pass
    return "-"

def proc_state(pid):
    # 'Z' matters: kill -0 succeeds for a zombie, so a worker that died during
    # startup would otherwise read as alive.
    try:
        with open(f"/proc/{pid}/stat") as fh:
            return fh.read().rsplit(") ", 1)[1].split(" ", 1)[0]
    except Exception:
        return None

rows = []
if os.path.isdir(cel_dir):
    for name in sorted(os.listdir(cel_dir)):
        if not name.endswith(".pid"):
            continue
        try:
            parts = open(os.path.join(cel_dir, name)).read().split()
            pid = int(parts[0])
            branch = parts[1] if len(parts) > 1 else name[:-4]
        except Exception:
            continue
        state = proc_state(pid)
        if state is None or state == "Z":
            status = "dead"
        else:
            log = os.path.join(log_dir, branch.replace("/", "_") + "-celery.log")
            try:
                with open(log, "rb") as fh:
                    status = "ready" if b" ready." in fh.read(4_000_000) else "starting"
            except Exception:
                status = "starting"
        rows.append((branch, pid, status, namespace_of(branch)))

if not rows:
    print("(no celery workers)")
else:
    print(f"{'BRANCH':<28}{'PID':<10}{'STATUS':<10}{'NS':<44}LOG")
    for branch, pid, status, ns in rows:
        log = os.path.join(log_dir, branch.replace("/", "_") + "-celery.log")
        print(f"{branch:<28}{pid:<10}{status:<10}{ns:<44}{log}")
PYCEL
        ;;
      *) echo "usage: dcw celery <start|stop|restart|status> [branch]" >&2; exit 2 ;;
    esac
    ;;

  logs)
    branch="${1:?usage: dcw logs <branch> [celery]}"
    target="${2:-server}"
    if [ "$target" = "celery" ]; then
      log=$(_celery_logfile "$branch")
    elif [ "$branch" = "$BASE" ]; then
      log="$LOGDIR/main.log"
    else
      log="$LOGDIR/$(_slug "$branch").log"
    fi
    [ -f "$log" ] || { echo "no log at $log" >&2; exit 2; }
    exec tail -f "$log"
    ;;

  *)
    cat <<HELP
dcw (local) — worktree + port + Django server + Celery lifecycle for $REPO

Usage:
  dcw start <branch>      Create worktree, clone DB, copy private files, point the
                          worktree .env at its own DB + Redis namespace, then start
                          the server and a per-branch Celery worker.
                          If <branch> == $BASE (base), runs in $REPO on port $PORT_BASE
  dcw stop [branch]       Stop server + worker for a branch; keeps worktree + branch
                          No branch → numbered menu of running captains (multi-select)
  dcw status              List active captains (port, pid, alive, celery) + URLs
  dcw list                Show all git worktrees (branch, port, dir)
  dcw path <branch>       Print the dir of a branch (base -> $REPO; worktree -> $WT_DIR/<branch>)
                          Used by the shell function below to cd after 'dcw start'
  dcw abort [branch]      Stop server + worker → destroy worktree → free port → DROP DB
                          No branch → numbered menu of dcw worktrees (multi-select)
  dcw logs <branch> [celery]
                          Tail the server log (default) or the branch's worker log

  dcw celery start|restart|stop [branch]
                          Start/restart/stop a branch's worker (default branch: $BASE)
  dcw celery status       Every worker with pid, alive state, Redis namespace, log

Per-branch isolation:
  Each worktree gets its own HMX_INSTANCE_NAMESPACE, and HMX derives every Redis
  key from it — hmx:<sha256(ns)>:celery: (broker + results), :cache, :celery-healthcheck.
  So branches share Redis DB indexes but never see each other's queues, results,
  cache or realtime events. Web and worker of a branch agree because both read the
  worktree .env.

Celery notes:
  - Worker queue set: $CELERY_QUEUES
  - 'dcw start' does NOT block on the worker: it reports "worker starting" and the
    worker keeps loading for ~15-30s (HMX imports the whole module registry).
    'dcw celery start' waits for readiness and fails if it never arrives.
    'dcw status' / 'dcw celery status' show ready vs starting vs dead.
  - Beat is NOT started per branch (multiple beats would double-fire schedules);
    use /opt/dev-tools/hmx-celery start beat for the base branch.
  - The base branch's worker is independent of hmx-celery; running both just means
    two workers on the base namespace.

Shell integration:
  'dcw' is installed as a shell FUNCTION (zsh/bash rc file) that calls the binary
  and, for 'dcw start', cds into the worktree that was just created. A child
  process cannot change its parent shell's directory, so this has to be a
  function. Override the binary it calls with DCW_BIN; bypass the function with
  'command dcw ...'. Re-run install.sh to refresh it.
  The installer also ships two venv helpers (see shell/venv.sh in the repo):
    venvhmx    activate the project venv and cd into the project
    venvhere   activate the venv for the CURRENT directory, staying put — pairs
               with 'dcw start <branch>', which moves you into the worktree
  Both read the dcw config for DEV_CAPTAIN_REPO / DEV_CAPTAIN_VENV.

Preview URLs (dcw status + dcw start):
  When a domain is known (DevSpace wildcard nginx), the URL column and the
  'preview:' line point at the reverse proxy instead of localhost:
    base branch : https://<user>.<domain>          (nginx -> 127.0.0.1:$PORT_BASE)
    worktree    : https://<user>-<port>.<domain>   (nginx -> 127.0.0.1:<port>)
  Same scheme as /opt/dev-tools/dev-captain. Without a domain (or DCW_DOMAIN=)
  they stay plain http://127.0.0.1:<port>.

State:
  Port registry:  $REG
  Logs:           $LOGDIR/
  Worker pidfiles:$CELERY_STATE/<branch>.pid
  Worktrees:      $WT_DIR/<branch>
  Ports range:    $PORT_BASE (base: $BASE) + $((PORT_BASE+1))-$((PORT_MAX-1)) (worktrees)

Env overrides:
  DEV_CAPTAIN_REPO   repo root      (default: \$HOME/dev/hmx-002)
  DEV_CAPTAIN_VENV   venv path      (default: \$HOME/dev/.venv)
  PORT_BASE          base port      (default: 5200)
  PORT_MAX           max port       (default: 5220)
  DCW_DOMAIN         preview URL domain (default: \$DEVSPACE_DOMAIN, else
                     /etc/devspace-nginx-routes.env; empty = 127.0.0.1 URLs)
  DCW_USER           user part of the preview host (default: \$USER)
  DCW_CELERY         1 = start a worker per branch, 0 = never (default: 1)
  DCW_CELERY_QUEUES  worker -Q list (default: $CELERY_QUEUES)
  DCW_CELERY_CONCURRENCY  worker --concurrency (default: $CELERY_CONCURRENCY)
  DCW_CELERY_LOGLEVEL     worker --loglevel    (default: $CELERY_LOGLEVEL)
HELP
    ;;
esac
